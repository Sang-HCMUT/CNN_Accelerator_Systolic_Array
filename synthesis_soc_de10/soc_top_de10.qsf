# Quartus Prime Settings for DE10-Standard Cyclone V SoC CNN Accelerator
# Target Device: Intel Cyclone V SE — 5CSXFC6D6F31C6
# Board:         Terasic DE10-Standard
# Array Size:    8x8 (64 PEs) — leverages Cyclone V's 112 DSP Blocks
# Quartus Ver:   Quartus Prime Lite 20.1

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY soc_top_de10
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# RTL Source Files (shared with DE1 project — same RTL, different parameters)
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/pe_gemm.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_skew_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_array_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/quantize_relu_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/matrix_buffer_a.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/matrix_buffer_b.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/matrix_buffer_c.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/gemm_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_accelerator_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_gemm_axi_lite.sv
set_global_assignment -name VERILOG_FILE ../RTL/picorv32.v
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/axi_interconnect.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/axi_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/seven_seg_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/axi_uart.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/soc_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/soc_top_de10.sv
set_global_assignment -name SDC_FILE soc_top_de10.sdc

# Parameter Overrides
set_parameter -name ARRAY_SIZE 8
set_parameter -name MEM_WORDS 8192

# Thermal & IO Settings
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Terasic DE10-Standard Pin Assignments
# Reference: DE10-Standard User Manual v1.3 — Intel Cyclone V 5CSXFC6D6F31C6N
# NOTE: Verify pins against your specific board revision before programming!

# Clock & Reset
# CLOCK_50[0]: 50 MHz crystal oscillator (Pin AF14)
# KEY[0]: Push-button reset, active-low (Pin AJ4)
set_location_assignment PIN_AF14 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_location_assignment PIN_AJ4 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# UART (GPIO_0 Header — 40-pin connector J1)
# GPIO_0[0] = Pin 1 on Header J1: TX output to Host PC (Pin W15)
# GPIO_0[1] = Pin 2 on Header J1: RX input from Host PC (Pin AK2)
# Connect USB-to-UART adapter (e.g. CP2102/CH340):
#   Adapter TXD -> FPGA GPIO_0[1] (Pin AK2, Header Pin 2)
#   Adapter RXD <- FPGA GPIO_0[0] (Pin W15, Header Pin 1)
#   Adapter GND -- FPGA GND       (Header Pin 12 or 30)
set_location_assignment PIN_W15 -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx
set_location_assignment PIN_AK2 -to uart_rx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx

# HEX0 (Units digit — Active-Low 7-segment)
set_location_assignment PIN_W17 -to hex0[0]
set_location_assignment PIN_V18 -to hex0[1]
set_location_assignment PIN_AG17 -to hex0[2]
set_location_assignment PIN_AG16 -to hex0[3]
set_location_assignment PIN_AH17 -to hex0[4]
set_location_assignment PIN_AG18 -to hex0[5]
set_location_assignment PIN_AH18 -to hex0[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[6]

# HEX1 (Tens digit — Active-Low 7-segment)
set_location_assignment PIN_AF16 -to hex1[0]
set_location_assignment PIN_V16 -to hex1[1]
set_location_assignment PIN_AE16 -to hex1[2]
set_location_assignment PIN_AD17 -to hex1[3]
set_location_assignment PIN_AE18 -to hex1[4]
set_location_assignment PIN_AE17 -to hex1[5]
set_location_assignment PIN_V17 -to hex1[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[6]

# HEX2 (Tied OFF in wrapper — Active-Low: all 1s = blank)
set_location_assignment PIN_AA21 -to hex2[0]
set_location_assignment PIN_AB17 -to hex2[1]
set_location_assignment PIN_AA18 -to hex2[2]
set_location_assignment PIN_Y17 -to hex2[3]
set_location_assignment PIN_Y18 -to hex2[4]
set_location_assignment PIN_AF18 -to hex2[5]
set_location_assignment PIN_W16 -to hex2[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[6]

# HEX3 (Tied OFF)
set_location_assignment PIN_Y19 -to hex3[0]
set_location_assignment PIN_W19 -to hex3[1]
set_location_assignment PIN_AD19 -to hex3[2]
set_location_assignment PIN_AA20 -to hex3[3]
set_location_assignment PIN_AC20 -to hex3[4]
set_location_assignment PIN_AA19 -to hex3[5]
set_location_assignment PIN_AD20 -to hex3[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex3[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex3[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex3[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex3[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex3[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex3[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex3[6]

# HEX4 (Tied OFF)
set_location_assignment PIN_AD21 -to hex4[0]
set_location_assignment PIN_AG22 -to hex4[1]
set_location_assignment PIN_AE22 -to hex4[2]
set_location_assignment PIN_AE23 -to hex4[3]
set_location_assignment PIN_AG23 -to hex4[4]
set_location_assignment PIN_AF23 -to hex4[5]
set_location_assignment PIN_AH22 -to hex4[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex4[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex4[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex4[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex4[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex4[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex4[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex4[6]

# HEX5 (Tied OFF)
set_location_assignment PIN_AF21 -to hex5[0]
set_location_assignment PIN_AG21 -to hex5[1]
set_location_assignment PIN_AF20 -to hex5[2]
set_location_assignment PIN_AG20 -to hex5[3]
set_location_assignment PIN_AE19 -to hex5[4]
set_location_assignment PIN_AF19 -to hex5[5]
set_location_assignment PIN_AB21 -to hex5[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex5[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex5[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex5[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex5[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex5[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex5[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex5[6]

# Red LEDs (DE10-Standard: 10x LEDR, Active-High)
# LEDR[0] = CPU Trap error indicator
# LEDR[1] = Systolic Array busy
# LEDR[2] = Tile computation done
# LEDR[3] = UART RX activity
# LEDR[4..7] = Spare diagnostic
# LEDR[8] = Heartbeat (1 Hz blink)
# LEDR[9] = Mode indicator (always ON = 8x8 mode)
set_location_assignment PIN_AA24 -to ledr[0]
set_location_assignment PIN_AB23 -to ledr[1]
set_location_assignment PIN_AC23 -to ledr[2]
set_location_assignment PIN_AD24 -to ledr[3]
set_location_assignment PIN_AG25 -to ledr[4]
set_location_assignment PIN_AF25 -to ledr[5]
set_location_assignment PIN_AE24 -to ledr[6]
set_location_assignment PIN_AF24 -to ledr[7]
set_location_assignment PIN_AB22 -to ledr[8]
set_location_assignment PIN_AC22 -to ledr[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ledr[9]

# Fitter Options

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top