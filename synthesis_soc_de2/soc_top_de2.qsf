# ============================================================================
# Quartus II Synthesis & Fitting Settings
# Target: Terasic DE2 Board (Altera Cyclone II EP2C35F672C6)
# Project: soc_top_de2
# ============================================================================

set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY soc_top_de2
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"

# Design Files
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/pe_gemm.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_skew_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_array_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/quantize_relu_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/matrix_buffer_a.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/matrix_buffer_b.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/matrix_buffer_c.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/gemm_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_accelerator_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/systolic_gemm_axi_lite.sv
set_global_assignment -name VERILOG_FILE ../RTL/picorv32.v
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/axi_interconnect.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/axi_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/seven_seg_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/axi_uart.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/soc_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/soc_top_de2.sv
set_global_assignment -name SDC_FILE soc_top_de2.sdc

set_parameter -name ARRAY_SIZE 8
set_parameter -name MEM_WORDS 8192

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ============================================================================
# Terasic DE2 Pin Assignments (from DE2_pin_assignments.csv)
# ============================================================================

# Clocks & Reset
set_location_assignment PIN_N2 -to clk
set_location_assignment PIN_G26 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# RS-232 UART Serial Port
set_location_assignment PIN_C25 -to uart_rx
set_location_assignment PIN_B25 -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx

# 7-Segment Displays (HEX0..HEX7) - Active Low
set_location_assignment PIN_AF10 -to hex0[0]
set_location_assignment PIN_AB12 -to hex0[1]
set_location_assignment PIN_AC12 -to hex0[2]
set_location_assignment PIN_AD11 -to hex0[3]
set_location_assignment PIN_AE11 -to hex0[4]
set_location_assignment PIN_V14 -to hex0[5]
set_location_assignment PIN_V13 -to hex0[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[2]
